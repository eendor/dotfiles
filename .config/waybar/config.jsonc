{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,

  "modules-left": [
    "custom/launcher",
    "wlr/taskbar"
  ],

  "modules-center": [
    "custom/inabakumori",
    "mpris",
    "clock",
    "custom/weather"
  ],

  "modules-right": [
    "pulseaudio",
    "backlight",
    "cpu",
    "memory",
    "temperature",
    "network",
    "bluetooth",
    "battery",
    "custom/restore",
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "☂",
    "tooltip": true,
    "tooltip-format": "稲葉曇 · Applications (Super + Space)",
    "on-click": "$HOME/.local/bin/osage-apps",
    "on-click-right": "rofi -show drun"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
      "theme-verification",
      "kitty-verify"
    ]
  },

  "custom/inabakumori": {
    "format": "「 稲葉曇 」",
    "tooltip": true,
    "tooltip-format": "INABAKUMORI · Osage-chan (おさげちゃん)",
    "on-click": "playerctl play-pause"
  },

  "mpris": {
    "format": "󰎆 {title} · {artist}",
    "format-paused": "󰏤 <i>{title}</i>",
    "format-stopped": "󰎆 Idle",
    "ignored-players": ["firefox"],
    "max-length": 30,
    "tooltip-format": "Playing: {title}\nArtist: {artist}\nAlbum: {album}",
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl previous",
    "on-click-right": "playerctl next"
  },

  "clock": {
    "format": "󰥔  {:%I:%M %p}",
    "format-alt": "󰃭  {:%a, %b %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "days": "<span color='#e0e0e8'><b>{}</b></span>",
        "weeks": "<span color='#707080'><b>W{}</b></span>",
        "weekdays": "<span color='#ffffff'><b>{}</b></span>",
        "today": "<span background='#ffffff' color='#121218'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 900,
    "signal": 8,
    "return-type": "json",
    "exec": "$HOME/.local/bin/waybar-weather",
    "on-click": "$HOME/.local/bin/osage-weather-view",
    "on-click-right": "$HOME/.local/bin/waybar-weather --refresh"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Volume: {volume}%\nDevice: {desc}"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "scroll-step": 5,
    "tooltip-format": "Brightness: {percent}%"
  },

  "cpu": {
    "interval": 3,
    "format": "󰍛  {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 5,
    "format": "󰘚  {percentage}%",
    "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
  },

  "temperature": {
    "thermal-zone": 7,
    "critical-threshold": 75,
    "format": "󰔏  {temperatureC}°C",
    "format-critical": "󰔏  {temperatureC}°C",
    "tooltip": true
  },

  "network": {
    "interval": 3,
    "format-wifi": "󰇚  {bandwidthDownBytes}",
    "format-ethernet": "󰇚  {bandwidthDownBytes}",
    "format-disconnected": "󰤭  Offline",
    "tooltip-format": "SSID: {essid}\nInterface: {ifname}\nIP: {ipaddr}\nSignal: {signalStrength}%\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty -e nmtui"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "on-click": "blueman-manager"
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 25,
      "critical": 10
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰂄  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery: {capacity}%\nTime remaining: {time}"
  },

  "custom/restore": {
    "format": "󰘔",
    "tooltip": true,
    "tooltip-format": "Restore Minimized Windows (Super+Shift+N)",
    "on-click": "$HOME/.local/bin/miku-windows restore"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Power Menu (Shutdown, Restart, Sleep, Logout)",
    "on-click": "$HOME/.local/bin/osage-power"
  }
}